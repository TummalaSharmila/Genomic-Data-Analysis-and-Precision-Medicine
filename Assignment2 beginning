# Download SRA files (prefetch) and convert to FASTQ (fasterq-dump)
# Note: you can also use 'fasterq-dump --split-files' or 'fastq-dump' depending on your toolkit version.
prefetch --option-file SraAccList.txt -O SRR/

for acc in $(cat SraAccList.txt); do
  fasterq-dump $acc -O data/fastq --threads 8
  gzip -f data/fastq/${acc}.fastq
  # Check: Should produce data/fastq/SRRxxxxxx.fastq.gz for each accession.
done



