## trimming

module load trimgalore # or activate the conda/env if needed
mkdir -p trimming
for fq in data/fastq/*.fastq data/fastq/*.fastq.gz; do
  echo "Trimming $fq ..."
  trim_galore --phred33 --fastqc "$fq" -o trimming
  # Each run produces a trimmed FASTQ and a FastQC report in ./trimming
done

## Reference setup
mkdir -p reference
cd reference
#####################################################################################################################################
# downloading hg38 from ncbi (GRCh38.p14, GCF_000001405.40)
wget "https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/000/001/405/GCF_000001405.40_GRCh38.p14/GCF_000001405.40_GRCh38.p14_genomic.fna.gz"
gunzip GCF_000001405.40_GRCh38.p14_genomic.fna.gz
# Result: GCF_000001405.40_GRCh38.p14_genomic.fna

## downloading annotation file from gencode
wget "https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_49/gencode.v49.annotation.gtf.gz"
gunzip gencode.v49.annotation.gtf.gz
# Result: gencode.v49.annotation.gtf
#####################################################################################################################################


## building the HISAT2 index

# first extracting splice sites and exons from the annotation

hisat2_extract_splice_sites.py gencode.v49.annotation.gtf > splicesites.tsv
hisat2_extract_exons.py gencode.v49.annotation.gtf > exons.tsv

#Build the HISAT2 index using the reference genome and annotation
hisat2-build -p 8 --ss splicesites.tsv --exon exons.tsv GCF_000001405.40_GRCh38.p14_genomic.fna hg38p14_hisat2_index

#####################################################################################################################################

# Download the reference genome FASTA (.fa.gz)
wget ftp://ftp.ensembl.org/pub/release-110/fasta/homo_sapiens/dna/Homo_sapiens.GRCh38.dna.primary_assembly.fa.gz
# Download the gene annotation GTF file
wget ftp://ftp.ensembl.org/pub/release-110/gtf/homo_sapiens/Homo_sapiens.GRCh38.110.gtf.gz
# Unzip the files (optional but recommended)
gunzip Homo_sapiens.GRCh38.dna.primary_assembly.fa.gz
gunzip Homo_sapiens.GRCh38.110.gtf.gz

hisat2-build Homo_sapiens.GRCh38.dna.primary_assembly.fa hg38_ensembl_index

mkdir -p alignments

for fq in trimming/*_trimmed.fq.gz; do   base=$(basename "$fq" _trimmed.fq.gz);   hisat2 -p 8 --dta -x reference/hg38_ensembl_index -U "$fq" -S alignments/"${base}.sam"; done
samtools view -@ 4 -bS alignments/SRRID.sam > alignments/SRRID.bam
samtools sort -@ 4 -o alignments/SRRID.sorted.bam alignments/SRRID.bam
samtools index alignments/SRRID.sorted.bam

for samfile in alignments/*.sam; do   base=$(basename "$samfile" .sam);   samtools view -@ 4 -bS "$samfile" > alignments/"$base".bam;   samtools sort -@ 4 -o alignments/"$base".sorted.bam alignments/"$base".bam;   samtools index alignments/"$base".sorted.bam; done




## Alignment with HISAT2
mkdir -p alignments

for fq in trimming/*_trimmed.fq.gz
do
  base=$(basename "$fq" _trimmed.fq.gz)
  hisat2 -p 8 --dta -x reference/hg38_ensembl_index -U "$fq" -S alignments/"${base}.sam"
done


for samfile in alignments/*.sam
do
  base=$(basename "$samfile" .sam)
  samtools view -@ 4 -bS "$samfile" > alignments/"$base".bam
  samtools sort -@ 4 -o alignments/"$base".sorted.bam alignments/"$base".bam
  samtools index alignments/"$base".sorted.bam
done
